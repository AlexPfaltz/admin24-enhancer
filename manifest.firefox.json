{
  "manifest_version": 3,
  "name": "Admin24 Enhancer",
  "version": "0.5.1",
  "description": "Улучшения интерфейса Admin24: полное наименование заявок в мобильной вёрстке, поиск в поле «Ответственный», темы оформления.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "admin24-enricher@alexpfaltz.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
        "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.admin24.app/*"],
  "action": {
    "default_title": "Admin24 Enhancer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "192": "icons/icon-192.png",
      "512": "icons/icon-512.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["themes.json", "vue-bridge-injected.js"],
      "matches": ["https://*.admin24.app/*",
                  "https://app.atlas24.pro/*"]
      
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.admin24.app/*"],
      "js": ["content.js"],
      "css": ["tickets-list.css", "theme.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.atlas24.pro/*"],
      "js": ["atlas24.js"],
      "css": ["theme.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}